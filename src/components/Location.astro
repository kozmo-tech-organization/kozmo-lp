---
import type { T } from '../i18n/translations';

interface Props {
  t: T['location'];
}

const { t } = Astro.props;
---

<div
  class="relative z-10 flex items-center justify-center gap-6 flex-wrap py-15 px-[5%]"
  style="border-top: 1px solid rgba(255,255,255,0.08); border-bottom: 1px solid rgba(255,255,255,0.08); background: rgba(124,58,237,0.03);"
>
  <div
    class="inline-flex items-center gap-2.5 rounded font-display text-[11px] font-semibold tracking-[1px] text-cyan px-5 py-2.5"
    style="background: rgba(0,229,255,0.08); border: 1px solid rgba(0,229,255,0.2);"
  >
    {t.badge}
  </div>
  <p class="text-[15px] text-muted-text">
    {t.desc}
  </p>
</div>
