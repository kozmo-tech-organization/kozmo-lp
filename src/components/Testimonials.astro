---
import type { T } from '../i18n/translations';

interface Props {
  t: T['testimonials'];
}

const { t } = Astro.props;

const avatarColor: Record<string, { bg: string; text: string }> = {
  cyan:   { bg: 'rgba(0,229,255,0.12)',   text: '#00E5FF' },
  purple: { bg: 'rgba(124,58,237,0.18)',  text: '#A855F7' },
  green:  { bg: 'rgba(16,185,129,0.12)',  text: '#10B981' },
  amber:  { bg: 'rgba(245,158,11,0.12)',  text: '#F59E0B' },
};

const quoteColor: Record<string, string> = {
  cyan:   '#00E5FF',
  purple: '#A855F7',
  green:  '#10B981',
  amber:  '#F59E0B',
};
---

<section
  id="depoimentos"
  class="relative z-10 py-25 px-[5%]"
  style="border-top: 1px solid rgba(255,255,255,0.08); background: rgba(124,58,237,0.03);"
>
  <div class="max-w-7xl mx-auto">

    <div class="mb-13 reveal">
      <div class="inline-flex items-center gap-2.5 font-display text-[9px] font-semibold tracking-[4px] uppercase text-cyan mb-5">
        <div class="w-6 h-px bg-cyan"></div>
        {t.eyebrow}
      </div>
      <h2 class="font-display font-extrabold leading-[1.15] tracking-[-0.5px] text-cosmos m-0"
        style="font-size: var(--text-section);">
        {t.title} <span
          style="background: linear-gradient(135deg, #00E5FF, #A855F7); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
        >{t.titleHighlight}</span>{t.titleSuffix}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {t.items.map(item => {
        const av = avatarColor[item.color] ?? avatarColor['cyan'];
        const qc = quoteColor[item.color] ?? quoteColor['cyan'];
        return (
          <div class="tm-card group relative overflow-hidden rounded-[16px] p-7 flex flex-col gap-5 reveal"
            style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);">

            <div class="top-bar absolute top-0 left-0 right-0 h-0.5 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"
              style="background: linear-gradient(90deg, #00E5FF, #A855F7);"></div>

            <div class="flex items-start justify-between">
              <span class="font-serif leading-none select-none" style={`font-size: 3.5rem; line-height: 1; color: ${qc}; opacity: 0.6;`}>"</span>
              <div class="flex gap-0.5">
                {[...Array(5)].map(() => (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="#F59E0B"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                ))}
              </div>
            </div>

            <p class="text-[14px] text-muted-text leading-[1.75] font-light flex-1">
              {item.quote}
            </p>

            <div class="flex items-center gap-3 pt-4" style="border-top: 1px solid rgba(255,255,255,0.07);">
              <div class="w-10 h-10 rounded-full flex items-center justify-center font-display text-[12px] font-bold shrink-0"
                style={`background: ${av.bg}; color: ${av.text}; border: 1px solid ${av.text}33;`}>
                {item.initials}
              </div>
              <div>
                <div class="text-[13px] font-semibold text-cosmos leading-none mb-1">{item.name}</div>
                <div class="text-[11px] text-muted-text">{item.role} · {item.company}</div>
              </div>
            </div>

          </div>
        );
      })}
    </div>

    <div class="flex justify-center mt-10 reveal">
      <a href="#contato" class="tm-btn">
        <span>{t.cta} <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
      </a>
    </div>

  </div>
</section>

<style>
  .tm-card:hover {
    border-color: rgba(255,255,255,0.14) !important;
    background: rgba(255,255,255,0.06) !important;
    transform: translateY(-3px);
    box-shadow: 0 8px 32px rgba(124,58,237,0.1);
  }

  .tm-btn {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 14.5px;
    padding: 14px 48px;
    background: linear-gradient(135deg, #7C3AED 0%, #00B8D4 100%);
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.25s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .tm-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #00B8D4 0%, #7C3AED 100%);
    opacity: 0;
    transition: opacity 0.25s;
  }
  .tm-btn:hover::after { opacity: 1; }
  .tm-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(124,58,237,0.5); }
  .tm-btn span { position: relative; z-index: 1; display: flex; align-items: center; gap: 8px; }
</style>
