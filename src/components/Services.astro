---
import type { T } from '../i18n/translations';

interface Props {
  t: T['services'];
}

const { t } = Astro.props;
---

<section
  id="servicos"
  class="relative z-10 py-25 px-[5%]"
  style="border-top: 1px solid rgba(255,255,255,0.08); border-bottom: 1px solid rgba(255,255,255,0.08); background: rgba(124,58,237,0.03);"
>
  <div class="max-w-7xl mx-auto">
    <div class="flex items-end justify-between mb-13 gap-5 flex-wrap reveal">
      <div>
        <div class="inline-flex items-center gap-2.5 font-display text-[9px] font-semibold tracking-[4px] uppercase text-cyan mb-5">
          <div class="w-6 h-px bg-cyan"></div>
          {t.eyebrow}
        </div>
        <h2 class="font-display font-extrabold leading-[1.15] tracking-[-0.5px] text-cosmos m-0"
          style="font-size: var(--text-section);">
          {t.title} <span
            style="background: linear-gradient(135deg, #00E5FF, #A855F7); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
          >{t.titleHighlight}</span>{t.titleSuffix}
        </h2>
      </div>
      <a href="#contato" class="btn-ghost-sm shrink-0">{t.viewAll}</a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
      {t.items.map(svc => (
        <div class="sv group relative overflow-hidden rounded-card p-7 transition-all duration-250 cursor-default"
          style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);">
          <div class="bottom-bar absolute bottom-0 left-0 right-0 h-0.5 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"
            style="background: linear-gradient(90deg, #00E5FF, #A855F7);"></div>
          <span class="font-display text-[10px] font-semibold tracking-[2px] text-cyan mb-5 block">{svc.num}</span>
          <span class="text-[28px] mb-3.5 block">{svc.icon}</span>
          <div class="text-[15px] font-bold text-cosmos mb-2.5 leading-[1.3]">{svc.title}</div>
          <div class="text-[13px] text-muted-text leading-[1.65]">{svc.desc}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .sv:hover {
    border-color: rgba(0,229,255,0.2) !important;
    background: rgba(0,229,255,0.04) !important;
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(0,229,255,0.08);
  }
  .btn-ghost-sm {
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-size: 14.5px;
    padding: 14px 32px;
    background: transparent;
    color: #E8EAFF;
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.25s;
    display: inline-flex;
    align-items: center;
  }
  .btn-ghost-sm:hover { border-color: #00E5FF; color: #00E5FF; }
</style>
