---
import type { T } from '../i18n/translations';

interface Props {
  t: T['footer'];
}

const { t } = Astro.props;
---

<footer
  class="relative z-10 flex items-center justify-between flex-wrap gap-5 px-[5%] py-10"
  style="background: rgba(0,0,0,0.4); border-top: 1px solid rgba(255,255,255,0.08);"
>
  <div class="flex items-center gap-2.5">
    <div
      class="w-7 h-7 rounded-full flex items-center justify-center font-display text-xs font-bold text-white"
      style="background: linear-gradient(135deg, #7C3AED, #00B8D4);"
    >K</div>
    <span class="font-display text-[13px] font-bold text-muted-text tracking-[2px]">KOZMO TECH</span>
  </div>

  <p class="text-xs text-soft-text">{t.copy}</p>

  <div class="flex gap-6 flex-wrap">
    {t.links.map(link => (
      <a
        href={link.href}
        class="text-xs text-soft-text hover:text-cyan no-underline transition-colors duration-200 tracking-[0.3px]"
      >
        {link.label}
      </a>
    ))}
  </div>
</footer>

<style>
  @media (max-width: 768px) {
    footer {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    footer > div:last-child { justify-content: center; }
  }
</style>
