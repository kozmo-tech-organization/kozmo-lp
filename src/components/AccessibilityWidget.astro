---
import type { T } from '../i18n/translations';

interface Props {
  t: T['accessibility'];
}

const { t } = Astro.props;
---

<div class="a11y-container fixed bottom-6 left-6 z-900">
  <button
    id="a11yToggle"
    class="a11y-btn flex items-center gap-2 rounded-full px-4 py-3 font-body text-xs font-semibold text-cosmos transition-all duration-250"
    style="background: rgba(124,58,237,0.9); border: 1px solid rgba(124,58,237,0.6); backdrop-filter: blur(12px);"
    aria-expanded="false"
    aria-label={t.open}
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10"/>
      <path d="M12 8h.01M11 12h1v4h1"/>
    </svg>
    <span class="hidden sm:inline">{t.open}</span>
  </button>

  <div
    id="a11yPanel"
    class="a11y-panel absolute bottom-14 left-0 w-60 rounded-[14px] p-5 hidden"
    style="background: rgba(6,5,15,0.97); border: 1px solid rgba(255,255,255,0.12); backdrop-filter: blur(20px); box-shadow: 0 20px 60px rgba(0,0,0,0.6);"
    role="dialog"
    aria-label={t.title}
  >
    <div class="font-display text-[11px] font-bold text-cosmos tracking-[2px] mb-4 uppercase">{t.title}</div>

    <div class="flex items-center justify-between mb-4">
      <span class="text-[13px] text-muted-text">{t.highContrast}</span>
      <button
        id="a11yContrast"
        class="toggle-btn w-11 h-6 rounded-full transition-all duration-300 relative"
        role="switch"
        aria-checked="false"
        aria-label={t.highContrast}
      >
        <span class="toggle-thumb absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white transition-all duration-300"></span>
      </button>
    </div>

    <div>
      <span class="text-[13px] text-muted-text block mb-2">{t.fontSize}</span>
      <div class="flex gap-2">
        <button data-size="small"  class="font-size-btn text-[11px]">{t.fontSmall}</button>
        <button data-size="normal" class="font-size-btn text-[11px] active">{t.fontNormal}</button>
        <button data-size="large"  class="font-size-btn text-[11px]">{t.fontLarge}</button>
      </div>
    </div>

    <button
      id="a11yReset"
      class="mt-4 w-full text-[11px] text-muted-text hover:text-cyan transition-colors py-1.5 font-medium"
    >{t.reset}</button>
  </div>
</div>

<script>
  const toggle  = document.getElementById('a11yToggle')!;
  const panel   = document.getElementById('a11yPanel')!;
  const contBtn = document.getElementById('a11yContrast')!;
  const resetBtn = document.getElementById('a11yReset')!;
  const html    = document.documentElement;

  toggle.addEventListener('click', () => {
    const isOpen = panel.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  document.addEventListener('click', e => {
    if (!toggle.contains(e.target as Node) && !panel.contains(e.target as Node)) {
      panel.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
    }
  });

  function syncContrast() {
    const on = html.classList.contains('high-contrast');
    contBtn.setAttribute('aria-checked', String(on));
    contBtn.style.background = on ? '#00E5FF' : 'rgba(255,255,255,0.12)';
    const thumb = contBtn.querySelector('.toggle-thumb') as HTMLElement;
    if (thumb) thumb.style.transform = on ? 'translateX(20px)' : 'translateX(0)';
  }

  contBtn.addEventListener('click', () => {
    html.classList.toggle('high-contrast');
    localStorage.setItem('high-contrast', html.classList.contains('high-contrast') ? '1' : '0');
    syncContrast();
  });

  function syncFontSize(size: string) {
    document.querySelectorAll<HTMLButtonElement>('.font-size-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.size === size);
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.font-size-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const size = btn.dataset.size ?? 'normal';
      html.dataset.fontSize = size;
      localStorage.setItem('font-size', size);
      syncFontSize(size);
    });
  });

  resetBtn.addEventListener('click', () => {
    html.classList.remove('high-contrast');
    html.dataset.fontSize = 'normal';
    localStorage.removeItem('high-contrast');
    localStorage.removeItem('font-size');
    syncContrast();
    syncFontSize('normal');
  });

  syncContrast();
  syncFontSize(html.dataset.fontSize ?? 'normal');
</script>

<style>
  .toggle-btn {
    background: rgba(255,255,255,0.12);
    border: none;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
  }

  .font-size-btn {
    flex: 1;
    padding: 6px 4px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
    color: #7A7D9C;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    transition: all 0.2s;
  }
  .font-size-btn:hover   { border-color: rgba(0,229,255,0.3); color: #00E5FF; }
  .font-size-btn.active  { border-color: rgba(0,229,255,0.5); color: #00E5FF; background: rgba(0,229,255,0.08); }

  .a11y-btn:hover { transform: scale(1.05); box-shadow: 0 4px 20px rgba(124,58,237,0.4); }
</style>
