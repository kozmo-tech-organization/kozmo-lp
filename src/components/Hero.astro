---
import type { T } from '../i18n/translations';

interface Props {
  t: T['hero'];
}

const { t } = Astro.props;
---

<section
  class="hero relative min-h-svh px-[5%] pt-32.5 pb-20 flex flex-col items-center justify-center text-center overflow-hidden"
  style="position: relative; z-index: 10;"
>
  <div class="orbit orbit1 absolute rounded-full pointer-events-none" aria-hidden="true"></div>
  <div class="orbit orbit2 absolute rounded-full pointer-events-none" aria-hidden="true"></div>
  <div class="orbit orbit3 absolute rounded-full pointer-events-none" aria-hidden="true"></div>

  <div
    class="inline-flex items-center gap-2.5 font-display text-[10px] font-semibold tracking-[4px] text-cyan mb-8"
    style="opacity: 0; animation: fadeUp 0.8s 0.2s ease forwards;"
  >
    <div class="w-8 h-px bg-cyan"></div>
    {t.kicker}
    <div class="w-8 h-px bg-cyan"></div>
  </div>

  <h1
    class="font-display font-black leading-[1.05] tracking-[-1px] text-cosmos max-w-240 mb-7"
    style="font-size: var(--text-hero); opacity: 0; animation: fadeUp 0.8s 0.3s ease forwards;"
  >
    {t.titleLine1}<br />
    <span
      class="glow-word"
      style="background: linear-gradient(135deg, #00E5FF, #A855F7, #EC4899); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; filter: drop-shadow(0 0 30px rgba(0,229,255,0.4));"
    >{t.titleLine2}</span><br />
    {t.titleLine3}
  </h1>

  <p
    class="text-muted-text max-w-140 leading-[1.75] font-light mb-12"
    style="font-size: clamp(15px, 2vw, 18px); opacity: 0; animation: fadeUp 0.8s 0.4s ease forwards;"
  >
    {t.desc}
  </p>

  <div
    class="flex gap-3.5 justify-center flex-wrap mb-18"
    style="opacity: 0; animation: fadeUp 0.8s 0.5s ease forwards;"
  >
    <a href="#contato" class="btn-primary">
      <span>
        {t.btn1}
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </span>
    </a>
    <a href="#servicos" class="btn-ghost">
      {t.btn2}
    </a>
  </div>

  <div
    class="flex items-center justify-center flex-wrap"
    style="opacity: 0; animation: fadeUp 0.8s 0.6s ease forwards;"
  >
    {t.stats.map((s, i) => (
      <div
        class={`hstat text-center px-10 ${i < t.stats.length - 1 ? 'border-r' : ''}`}
        style={i < t.stats.length - 1 ? 'border-color: rgba(255,255,255,0.08)' : ''}
      >
        <span
          class="font-display font-extrabold block leading-none mb-1.5"
          style="font-size: 32px; background: linear-gradient(135deg, #00E5FF, #A855F7); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
        >{s.num}</span>
        <span class="text-xs text-muted-text">{s.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .orbit {
    border: 1px solid rgba(0,229,255,0.08);
    animation: orbitSpin linear infinite;
    top: 50%;
    left: 50%;
  }
  .orbit1  { width: 600px;  height: 600px;  animation-duration: 60s; }
  .orbit2  { width: 900px;  height: 900px;  animation-duration: 90s;  border-color: rgba(124,58,237,0.06); }
  .orbit3  { width: 1200px; height: 1200px; animation-duration: 120s; border-color: rgba(236,72,153,0.04); }

  .orbit1::after {
    content: '';
    position: absolute;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #00E5FF;
    top: -3px; left: 50%;
    box-shadow: 0 0 12px #00E5FF;
  }
  .orbit2::after {
    content: '';
    position: absolute;
    width: 5px; height: 5px;
    border-radius: 50%;
    background: #A855F7;
    bottom: -2px; right: 20%;
    box-shadow: 0 0 10px #A855F7;
  }

  @keyframes orbitSpin {
    from { transform: translate(-50%,-50%) rotate(0deg); }
    to   { transform: translate(-50%,-50%) rotate(360deg); }
  }

  .btn-primary {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 14.5px;
    padding: 14px 32px;
    background: linear-gradient(135deg, #7C3AED 0%, #00B8D4 100%);
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.25s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    position: relative;
    overflow: hidden;
  }
  .btn-primary::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #00B8D4 0%, #7C3AED 100%);
    opacity: 0;
    transition: opacity 0.25s;
  }
  .btn-primary:hover::after { opacity: 1; }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(124,58,237,0.5); }
  .btn-primary span  { position: relative; z-index: 1; display: flex; align-items: center; gap: 8px; }

  .btn-ghost {
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-size: 14.5px;
    padding: 14px 32px;
    background: transparent;
    color: #E8EAFF;
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.25s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .btn-ghost:hover { border-color: #00E5FF; color: #00E5FF; }

  @media (max-width: 768px) {
    .orbit1, .orbit2, .orbit3 { display: none; }
    .hstat {
      padding: 16px 20px;
      border-right: none !important;
      border-bottom: 1px solid rgba(255,255,255,0.08) !important;
      width: 50%;
    }
    .hstat:nth-child(odd)  { border-right: 1px solid rgba(255,255,255,0.08) !important; }
    .hstat:nth-last-child(-n+2) { border-bottom: none !important; }
  }

  @media (max-width: 390px) {
    .hstat { width: 100%; border-right: none !important; }
  }
</style>
