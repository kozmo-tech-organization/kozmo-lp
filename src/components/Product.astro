---
import type { T } from '../i18n/translations';

interface Props {
  t: T['product'];
}

const { t } = Astro.props;

const statusClass: Record<string, string> = {
  ok:   'ml-ok',
  pend: 'ml-pend',
  canc: 'ml-canc',
};
const statNumColor: Record<string, string> = {
  cyan:         '#00E5FF',
  'neon-green': '#10B981',
  'neon-amber': '#F59E0B',
};
---

<section id="produto" class="relative z-10 py-25 px-[5%]">
  <div class="max-w-7xl mx-auto">

    <div class="mb-13 reveal">
      <div class="inline-flex items-center gap-2.5 font-display text-[9px] font-semibold tracking-[4px] uppercase text-cyan mb-5">
        <div class="w-6 h-px bg-cyan"></div>
        {t.eyebrow}
      </div>
      <h2 class="font-display font-extrabold leading-[1.15] tracking-[-0.5px] text-cosmos m-0"
        style="font-size: var(--text-section);">
        {t.sectionTitle} <span
          style="background: linear-gradient(135deg, #00E5FF, #A855F7); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
        >{t.sectionHighlight}</span>{t.sectionSuffix}
      </h2>
    </div>


    <div class="prod-box reveal relative overflow-hidden rounded-[20px] mb-5"
      style="background: linear-gradient(135deg, rgba(16,185,129,0.1) 0%, rgba(0,229,255,0.06) 100%); border: 1px solid rgba(16,185,129,0.25);">

      <div class="absolute inset-0 pointer-events-none"
        style="background: radial-gradient(ellipse at top left, rgba(16,185,129,0.15) 0%, transparent 60%);"></div>

      <div class="grid grid-cols-1 lg:grid-cols-2">
        <div class="relative z-1 py-15 px-13 max-sm:py-9 max-sm:px-7">
          <div class="inline-flex items-center gap-1.5 rounded px-3.5 py-1.25 font-display text-[9px] font-semibold tracking-[2px] text-neon-green mb-6"
            style="background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.3); color: #10B981;">
            <span class="w-1.5 h-1.5 rounded-full inline-block" style="background:#10B981; box-shadow: 0 0 6px #10B981;"></span>
            {t.tag}
          </div>

          <h2 class="font-display font-extrabold leading-[1.2] tracking-[-0.5px] text-cosmos mb-4.5"
            style="font-size: var(--text-prod-title);">
            {t.title} <span
              style="background: linear-gradient(135deg, #00E5FF, #A855F7); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
            >{t.titleHighlight}</span> {t.titleSuffix}
          </h2>

          <p class="text-[15px] text-muted-text leading-[1.7] font-light mb-7">{t.desc}</p>

          <ul class="flex flex-col gap-2.5 mb-9 list-none p-0">
            {t.features.map(feat => (
              <li class="flex items-center gap-2.5 text-sm text-cosmos/85">
                <div class="shrink-0 w-5 h-5 rounded-full flex items-center justify-center text-[10px]"
                  style="background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); color: #10B981;">✓</div>
                {feat}
              </li>
            ))}
          </ul>

          <a href="#contato" class="btn-cosmos">
            {t.cta}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <div class="relative z-1 flex items-center justify-center p-9 max-sm:p-5 mock-bg min-h-70">
          <div class="mock w-full max-w-xs max-sm:max-w-full overflow-hidden rounded-card"
            style="background: rgba(6,5,15,0.95); border: 1px solid rgba(0,229,255,0.15); box-shadow: 0 20px 60px rgba(0,0,0,0.6), 0 0 40px rgba(0,229,255,0.08);">
            <div class="flex items-center gap-1.5 px-3.5 py-2.5" style="background: rgba(255,255,255,0.04); border-bottom: 1px solid rgba(255,255,255,0.06);">
              <div class="w-2 h-2 rounded-full" style="background: #FF5F57;"></div>
              <div class="w-2 h-2 rounded-full" style="background: #FEBC2E;"></div>
              <div class="w-2 h-2 rounded-full" style="background: #28C840;"></div>
              <div class="flex-1 h-1.75 rounded mx-2.5" style="background: rgba(255,255,255,0.06);"></div>
            </div>
            <div class="p-3.5">
              <div class="grid grid-cols-3 gap-1.75 mb-3">
                {t.mock.statItems.map(s => (
                  <div class="rounded-[7px] py-2.5 px-2 text-center" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06);">
                    <span class="font-display text-[15px] font-bold block leading-none" style={`color: ${statNumColor[s.color] ?? '#E8EAFF'};`}>{s.num}</span>
                    <span class="text-[9px] text-muted-text mt-0.75 block">{s.label}</span>
                  </div>
                ))}
              </div>
              <div class="font-display text-[8px] font-semibold tracking-[2px] uppercase text-muted-text mb-2">{t.mock.scheduleLabel}</div>
              <div class="flex flex-col gap-1.25">
                {t.mock.scheduleItems.map(item => (
                  <div class={`ml-item ${statusClass[item.status]} flex items-center gap-2 px-2.5 py-2 rounded-[7px] text-[11px]`}>
                    <div class="status-dot w-1.5 h-1.5 rounded-full shrink-0"></div>
                    <span class="ml-time text-[10px] text-muted-text min-w-12 font-display">{item.time}</span>
                    <span class="flex-1 font-medium text-cosmos">{item.name}</span>
                    <span class="ml-status text-[9.5px] font-semibold">{item.label}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Pipeline — in development -->
    <div class="reveal">
      <div class="inline-flex items-center gap-2 mb-4 font-display text-[9px] font-semibold tracking-[3px] uppercase"
        style="color: rgba(255,255,255,0.35);">
        <div class="w-4 h-px" style="background: rgba(255,255,255,0.2);"></div>
        {t.pipelineLabel}
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {t.pipeline.map(p => (
          <div class="pipe-card group relative overflow-hidden rounded-[16px] p-6 transition-all duration-250"
            style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07);">
            <div class="top-bar absolute top-0 left-0 right-0 h-0.5 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"
              style="background: linear-gradient(90deg, #7C3AED, #A855F7);"></div>

            <div class="flex items-start justify-between mb-4">
              <span class="text-3xl">{p.icon}</span>
              <span class="inline-flex items-center gap-1 rounded px-2.5 py-1 font-display text-[8px] font-semibold tracking-[1.5px] uppercase"
                style="background: rgba(168,85,247,0.1); border: 1px solid rgba(168,85,247,0.25); color: #A855F7;">
                ◆ {t.pipelineTag}
              </span>
            </div>

            <h3 class="font-display text-[15px] font-bold text-cosmos mb-2 tracking-[-0.3px]">{p.title}</h3>
            <p class="text-[13px] text-muted-text leading-[1.65] font-light mb-4">{p.desc}</p>

            <ul class="flex flex-col gap-1.75 list-none p-0">
              {p.features.map(f => (
                <li class="flex items-center gap-2 text-[12px] text-cosmos/70">
                  <div class="shrink-0 w-4 h-4 rounded-full flex items-center justify-center text-[9px]"
                    style="background: rgba(168,85,247,0.1); border: 1px solid rgba(168,85,247,0.25); color: #A855F7;">✓</div>
                  {f}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="flex justify-center mt-10 reveal">
      <a href="#contato" class="prod-cta-btn">
        <span>{t.startCta} <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
      </a>
    </div>

  </div>
</section>

<style>
  .mock-bg {
    background: rgba(0,0,0,0.3);
    position: relative;
  }
  .mock-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,229,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,229,255,0.04) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .btn-cosmos {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 14px;
    padding: 13px 28px;
    background: linear-gradient(135deg, #059669, #00B8D4);
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.25s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .btn-cosmos:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(16,185,129,0.3); }

  .ml-item.ml-ok   { background: rgba(16,185,129,0.08);  border: 1px solid rgba(16,185,129,0.2); }
  .ml-item.ml-pend { background: rgba(245,158,11,0.08);  border: 1px solid rgba(245,158,11,0.2); }
  .ml-item.ml-canc { background: rgba(239,68,68,0.08);   border: 1px solid rgba(239,68,68,0.2); }

  .ml-ok   .status-dot { background: #10B981; box-shadow: 0 0 6px #10B981; }
  .ml-pend .status-dot { background: #F59E0B; box-shadow: 0 0 6px #F59E0B; }
  .ml-canc .status-dot { background: #EF4444; box-shadow: 0 0 6px #EF4444; }

  .ml-ok   .ml-status { color: #10B981; }
  .ml-pend .ml-status { color: #F59E0B; }
  .ml-canc .ml-status { color: #EF4444; }

  .pipe-card:hover {
    border-color: rgba(168,85,247,0.2) !important;
    background: rgba(168,85,247,0.04) !important;
    transform: translateY(-3px);
    box-shadow: 0 8px 32px rgba(168,85,247,0.08);
  }

  .prod-cta-btn {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 14.5px;
    padding: 14px 48px;
    background: linear-gradient(135deg, #7C3AED 0%, #00B8D4 100%);
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.25s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .prod-cta-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #00B8D4 0%, #7C3AED 100%);
    opacity: 0;
    transition: opacity 0.25s;
  }
  .prod-cta-btn:hover::after { opacity: 1; }
  .prod-cta-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(124,58,237,0.5); }
  .prod-cta-btn span { position: relative; z-index: 1; display: flex; align-items: center; gap: 8px; }
</style>
